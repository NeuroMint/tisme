# Local SQLite database (created automatically, path is relative to app/)
DATABASE_URL="file:./dev.db"

# Optional. Without this, audio answers are stored but not auto-transcribed —
# you can still type the transcript in manually.
OPENAI_API_KEY=

# Optional. Without this, drafts are saved as-is (your typed text, or the
# raw transcript) instead of being polished into narrative prose.
ANTHROPIC_API_KEY=
